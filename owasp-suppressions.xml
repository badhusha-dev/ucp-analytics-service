<?xml version="1.0" encoding="UTF-8"?>
<suppressions xmlns="https://jeremylong.github.io/DependencyCheck/dependency-suppression.1.3.xsd">
    <!-- OWASP Dependency-Check Suppression Configuration for E-Commerce Microservices -->
    <suppress>
        <notes><![CDATA[
        Suppression of development-only annotation processors (compile-time only, stripped at runtime).
        ]]></notes>
        <packageUrl regex="true">^pkg:maven/org\.projectlombok/lombok@.*$</packageUrl>
        <cpe>cpe:/a:lombok_project:lombok</cpe>
    </suppress>
    <suppress>
        <notes><![CDATA[
        Suppression of embedded test database and WireMock test harness utilities.
        ]]></notes>
        <packageUrl regex="true">^pkg:maven/com\.h2database/h2@.*$</packageUrl>
        <packageUrl regex="true">^pkg:maven/org\.wiremock/.*$</packageUrl>
    </suppress>
</suppressions>
